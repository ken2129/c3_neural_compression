        <mxCell id="wall-uid-body" value="同じ実験コンテナでも、監督はroot、CodexはUID10002。&#10;追加groupなし / no-new-privileges。&#10;固定コード・root私有状態を保護する。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#53677A;align=left;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=none;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="wall-uid">
          <mxGeometry as="geometry" x="14" y="57" width="537" height="169" />
        </mxCell>
        <mxCell id="limits" value="制限の対象は管理操作と権限。モデル・GitHubへの外向き通信や、研究UIDで読める既存ファイルの利用は可能。&#10;共有設定やDocker APIの公開を変更すれば前提も変わる。コンテナはホストとカーネルを共有し、絶対的な隔離ではない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#F0F4F8;strokeColor=#718298;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1130" width="1815" height="100" />
        </mxCell>
      </root>
