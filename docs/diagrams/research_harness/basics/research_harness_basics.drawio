        <mxCell id="roles-body" value="監督プログラム：root（UID0）。&#10;研究するCodex：非root（UID10002）。&#10;同じ実験コンテナの中でも権限を分ける。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=24;fontColor=#53677A;align=left;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=none;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="roles">
