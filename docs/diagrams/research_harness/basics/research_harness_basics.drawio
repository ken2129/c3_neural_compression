        <mxCell id="outside" value="①にはDockerの操作権限が必要。&#10;管理側の固定コードだけが持つ。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=23;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#EAF2FC;strokeColor=#2864A5;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="115" y="625" width="540" height="95" />
        </mxCell>
        <mxCell id="inside" value="②は、すでに実験コンテナ内にいるプロセスの通常の操作。&#10;Pythonを起動するたびにDockerへ依頼する必要はない。&#10;そのため、CodexにDocker socketを渡さずに研究を進められる。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=27;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#E8F6F6;strokeColor=#087E8B;rounded=1;arcSize=12;" vertex="1" parent="1">
