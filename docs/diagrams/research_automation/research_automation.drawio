        <mxCell id="observe" value="nvidia-smiで観測&#10;compute-processなし&#10;利用率 &lt;=5% / メモリ &lt;=256MiB" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#ECF7EE;strokeColor=#32754B;rounded=1;arcSize=12;" vertex="1" parent="gpu-frame">
          <mxGeometry as="geometry" x="35" y="110" width="390" height="125" />
        </mxCell>
        <mxCell id="stable" value="3回連続で空きを観測&#10;概ね1秒間隔&#10;max_wait とjob予算内" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#ECF7EE;strokeColor=#32754B;rounded=1;arcSize=12;" vertex="1" parent="gpu-frame">
          <mxGeometry as="geometry" x="520" y="110" width="390" height="125" />
        </mxCell>
        <mxCell id="lock" value="GPU別ローカルlock&#10;取得後に空きを再観測&#10;外部jobの排他予約ではない" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#ECF7EE;strokeColor=#32754B;rounded=1;arcSize=12;" vertex="1" parent="gpu-frame">
          <mxGeometry as="geometry" x="1005" y="110" width="390" height="125" />
        </mxCell>
        <mxCell id="select" value="許可GPUを1枚選択&#10;CUDA_VISIBLE_DEVICES=UUID&#10;JAX事前確保を無効化" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#ECF7EE;strokeColor=#32754B;rounded=1;arcSize=12;" vertex="1" parent="gpu-frame">
          <mxGeometry as="geometry" x="1490" y="110" width="350" height="125" />
        </mxCell>
        <mxCell id="running" value="B  同じCodexセッションで研究を実行&#10;CPU affinity / processごとのRLIMIT_CPU・FSIZE / protocol出力制限&#10;job予算に回収用20秒を確保。金額hard capではない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#E8F6F6;strokeColor=#087E8B;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="535" width="890" height="150" />
        </mxCell>
        <mxCell id="samples" value="C  最短0.5秒間隔の観測&#10;子孫RSS・thread数 / workspace増分 + 一時home / 最低空き&#10;選択GPUのcompute-process &gt;1なら競合とみなす" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#E8F6F6;strokeColor=#087E8B;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="535" width="850" height="150" />
        </mxCell>
        <mxCell id="lease" value="D  承認・接続の継続確認&#10;managerが承認を再確認。brokerは約2秒ごとにlease&#10;実験側は10秒のlease窓。取消・期限・途絶で自job停止" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#EAF2FC;strokeColor=#2864A5;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="750" width="890" height="145" />
        </mxCell>
        <mxCell id="limits" value="既存コンテナ：既存割当は変更せずsampled limit&#10;新規作成：Docker CPU / RAM / PIDs上限も設定&#10;観測の合間の瞬間超過や絶対peakを保証しない" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=20;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#FFF4DC;strokeColor=#9D640D;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1050" y="750" width="850" height="145" />
        </mxCell>
        <mxCell id="cleanup" value="E  正常・失敗・取消のいずれも回収へ&#10;自jobの子孫にSIGTERM → 必要ならSIGKILL → waitpidでECHILD&#10;認証refreshの保存ACK → job用home削除 → cleanup_verified" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#E8F6F6;strokeColor=#087E8B;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1000" width="1180" height="190" />
        </mxCell>
        <mxCell id="uncertain" value="回収・認証保存が不明&#10;blocked / gateを保持&#10;次の研究jobを始めない&#10;claimを消して再試行しない" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#FCEDEF;strokeColor=#AD3E45;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1370" y="1000" width="530" height="190" />
        </mxCell>
        <mxCell id="cleanup-uncertain-label" value="確認失敗" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=16;fontColor=#AD3E45;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1245.0" y="1051.0" width="140" height="28.0" />
        </mxCell>
        <mxCell id="distinguish" value="独立したSlack空き通知：60秒周期で3分継続を確認する補助プロセス。上記の3回観測とは別。&#10;空き通知は予約・研究起動・controllerのONではなく、現在の2コンテナ経路へ統合した機能でもない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#F0F4F8;strokeColor=#718298;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="80" y="1230" width="1820" height="65" />
        </mxCell>
