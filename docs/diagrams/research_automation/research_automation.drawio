        <mxCell id="m12" value="" style="edgeStyle=none;rounded=0;html=0;strokeColor=#2864A5;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry as="geometry" relative="1">
            <mxPoint as="sourcePoint" x="800" y="1130" />
            <mxPoint as="targetPoint" x="1490" y="1130" />
          </mxGeometry>
        </mxCell>
        <mxCell id="heading" value="02  イベント受付・承認・開始のシーケンス" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=34;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=1;spacing=0;strokeWidth=2;fillColor=none;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="28" width="1840" height="50" />
        </mxCell>
        <mxCell id="subtitle" value="receiptは通知、ownerコメントは承認、claimは実行消費。3つを別々に扱う。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=19;fontColor=#53677A;align=left;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=none;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="86" width="1890" height="48" />
        </mxCell>
        <mxCell id="footer" value="02 / 07   |   仕様基準: docs/research_automation_spec.md @ ed3ce770   |   実装: PR108 @ 21af4c2d" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=14;fontColor=#53677A;align=left;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=none;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1324" width="1890" height="24" />
        </mxCell>
        <mxCell id="source" value="根拠: actions_inbox.py / direct_pr_service.py / execution_delivery.py / resident launcher" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=14;fontColor=#53677A;align=left;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=none;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="1352" width="1890" height="26" />
        </mxCell>
        <mxCell id="gh" value="" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=1;spacing=12;strokeWidth=2;fillColor=#F0F4F8;strokeColor=#718298;rounded=1;arcSize=12;" vertex="1" parent="1" tooltip="GitHub&#10;Issue / 承認">
          <mxGeometry as="geometry" x="20.0" y="155" width="260" height="80" />
        </mxCell>
        <mxCell id="runner" value="" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=1;spacing=12;strokeWidth=2;fillColor=#EAF2FC;strokeColor=#2864A5;rounded=1;arcSize=12;" vertex="1" parent="1" tooltip="runner / UID10003&#10;固定submit client">
          <mxGeometry as="geometry" x="340.0" y="155" width="260" height="80" />
        </mxCell>
        <mxCell id="mgr" value="" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=1;spacing=12;strokeWidth=2;fillColor=#EAF2FC;strokeColor=#2864A5;rounded=1;arcSize=12;" vertex="1" parent="1" tooltip="manager / UID10001&#10;承認・直列dispatch">
          <mxGeometry as="geometry" x="670.0" y="155" width="260" height="80" />
        </mxCell>
        <mxCell id="store" value="" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=1;spacing=12;strokeWidth=2;fillColor=#EAF2FC;strokeColor=#2864A5;rounded=1;arcSize=12;" vertex="1" parent="1" tooltip="永続状態&#10;inbox / 実行台帳">
          <mxGeometry as="geometry" x="1010.0" y="155" width="260" height="80" />
        </mxCell>
        <mxCell id="broker" value="" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=1;spacing=12;strokeWidth=2;fillColor=#EAF2FC;strokeColor=#2864A5;rounded=1;arcSize=12;" vertex="1" parent="1" tooltip="root broker&#10;ローカルDocker">
          <mxGeometry as="geometry" x="1360.0" y="155" width="260" height="80" />
        </mxCell>
        <mxCell id="sup" value="" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=1;spacing=12;strokeWidth=2;fillColor=#E8F6F6;strokeColor=#087E8B;rounded=1;arcSize=12;" vertex="1" parent="1" tooltip="実験supervisor&#10;root・モデル未起動">
          <mxGeometry as="geometry" x="1710.0" y="155" width="260" height="80" />
        </mxCell>
        <mxCell id="m01-text" value="1  Issue / commentイベント →&#10;Actions job" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="165.0" y="247.35" width="290" height="49.65" />
        </mxCell>
        <mxCell id="m02-text" value="2  receipt（Unix socket / peer&#10;UID照合）" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="485.0" y="317.35" width="300" height="49.65" />
        </mxCell>
        <mxCell id="m03-text" value="3  receiptを永続化 / FULL&#10;commit" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815.0" y="387.35" width="310" height="49.65" />
        </mxCell>
        <mxCell id="m04-text" value="4  commit後ACK → Actionsは&#10;配送成功" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="485.0" y="452.35" width="300" height="49.65" />
        </mxCell>
        <mxCell id="off-note" value="OFFでも受付設定がONならreceiptを保存。&#10;OFFの間は取出し・新規実行を始めない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#FFF4DC;strokeColor=#9D640D;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="555" width="550" height="85" />
        </mxCell>
        <mxCell id="m05-text" value="5  ON時にPENDING → ACTIVE" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815.0" y="627.0" width="310" height="25.0" />
        </mxCell>
        <mxCell id="m06-text" value="6  現行Issue・未編集owner承認を再取得 / 内容hash・期限・取消を照合" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="165.0" y="697.0" width="620" height="25.0" />
        </mxCell>
        <mxCell id="m07-text" value="7  モデル・scope・予算を解決 → preflight要求" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815.0" y="767.0" width="660" height="25.0" />
        </mxCell>
        <mxCell id="m08-text" value="8  acquire / 公開bootstrap /&#10;prepare" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1505.0" y="812.35" width="320" height="49.65" />
        </mxCell>
        <mxCell id="m09-text" value="9  ready（epoch + policy hash）" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#087E8B;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1505.0" y="902.0" width="320" height="25.0" />
        </mxCell>
        <mxCell id="m10-text" value="10  実行前チェック通過（開始境界）。この後のOFFだけでは取り消さない" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815.0" y="967.0" width="660" height="25.0" />
        </mxCell>
        <mxCell id="m11-text" value="11  owner記録確認 + 単回claimを&#10;保存" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815.0" y="1007.35" width="310" height="49.65" />
        </mxCell>
        <mxCell id="m12-text" value="12  bindingを送る。brokerがjob認証を読み、executeへ" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="815.0" y="1097.0" width="660" height="25.0" />
        </mxCell>
        <mxCell id="prepared" value="prepareまで：モデル認証は実験側へ渡さず、model turnも開始しない。&#10;同一Issueの既存claim、未登録先、scope/予算/承認不一致は、新しい研究実行に進まない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=19;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#F0F4F8;strokeColor=#718298;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1190" width="1840" height="95" />
        </mxCell>
