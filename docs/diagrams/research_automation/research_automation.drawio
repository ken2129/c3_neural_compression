        <mxCell id="gate" value="D  回収・起動時の停止gate&#10;起動時の未確定CLAIMED / cleanup不明 / latchあり&#10;→ 新規dispatchを止める。自動reset・研究retryをしない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=22;fontColor=#183047;align=center;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#FCEDEF;strokeColor=#AD3E45;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1030" width="1020" height="200" />
        </mxCell>
        <mxCell id="separation" value="配送のACTIVE → PENDINGは、研究claimの解除ではない。&#10;WORKER_FINISHEDは科学的成功の証明ではない。&#10;管理側終了だけでは実験側の回収済みを証明しない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=21;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#F0F4F8;strokeColor=#718298;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="1030" width="750" height="200" />
        </mxCell>
      </root>
