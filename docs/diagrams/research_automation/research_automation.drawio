        <mxCell id="x01-text" value="1  execute：binding + job用認証" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#9D640D;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="525.0" y="267.0" width="320" height="25.0" />
        </mxCell>
        <mxCell id="gpuwait" value="2  GPU空き待機・lock・再観測&#10;モデル認証homeを準備 → 版照合済みCodex起動" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#E8F6F6;strokeColor=#087E8B;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="345" width="630" height="85" />
        </mxCell>
        <mxCell id="x03-text" value="3  Codexセッションを1回起動" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#087E8B;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="875.0" y="457.0" width="320" height="25.0" />
        </mxCell>
        <mxCell id="modelwork" value="4  コード調査・編集 → 実験 → 完了待ち → 解析&#10;同一セッション。実験後に解析用Codexを呼び直さない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#E8F6F6;strokeColor=#087E8B;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1040" y="525" width="850" height="85" />
        </mxCell>
        <mxCell id="x05-text" value="5  manifest・planを渡してpublish" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#32754B;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1225.0" y="642.0" width="310" height="25.0" />
        </mxCell>
        <mxCell id="x06-text" value="6  intent → branch / PR →&#10;readback" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#32754B;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1565.0" y="687.35" width="270" height="49.65" />
        </mxCell>
        <mxCell id="x07-text" value="7  最終JSON：outcome /&#10;summary / pr_url" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#087E8B;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="875.0" y="757.35" width="320" height="49.65" />
        </mxCell>
        <mxCell id="cleanup" value="8  transportを閉じる → 子孫を停止・reap → ECHILD&#10;必要な認証refreshを管理側へ返して保存ACKを確認 → 一時home削除" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#FFF4DC;strokeColor=#9D640D;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="690" y="850" width="960" height="95" />
        </mxCell>
        <mxCell id="x09-text" value="9  worker_result / failure +&#10;cleanup_verified" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#087E8B;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="525.0" y="952.35" width="320" height="49.65" />
        </mxCell>
        <mxCell id="x10-text" value="10  私有結果保存・構造化結果 / 失&#10;敗を返す" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="185.0" y="1017.35" width="310" height="49.65" />
        </mxCell>
        <mxCell id="x11-text" value="11  job_finished → 管理側回収&#10;ACK → receipt FINISHED" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=17;fontColor=#2864A5;align=center;verticalAlign=middle;fontStyle=0;spacing=0;strokeWidth=2;fillColor=#FFFFFF;strokeColor=none;rounded=0;arcSize=12;shape=rectangle;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="185.0" y="1082.35" width="310" height="49.65" />
        </mxCell>
        <mxCell id="loops" value="実行中の並行監督：managerが承認再確認 → brokerは約2秒ごとにlease。実験側のlease窓は10秒。&#10;OFFは次の仕事を止める。取消・期限・lease途絶・資源違反は現在の自jobを止める。回収不明なら次を始めない。" style="html=0;whiteSpace=wrap;fontFamily=Hiragino Sans;fontSize=18;fontColor=#183047;align=left;verticalAlign=middle;fontStyle=0;spacing=12;strokeWidth=2;fillColor=#F0F4F8;strokeColor=#718298;rounded=1;arcSize=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="1200" width="1850" height="90" />
        </mxCell>
