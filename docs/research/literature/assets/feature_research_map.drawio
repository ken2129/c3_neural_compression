        </mxCell>
        <mxCell id="137" value="線は発表年への対応であり、引用・継承関係ではない。分類は重複しうる。赤は非INRの動画研究も含む。2019年は省略し、横方向の距離は時間に比例しない。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Noto Sans CJK JP;fontSize=16;fontColor=#64748B;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="74" y="1430" width="2270" height="26" as="geometry" />
        </mxCell>
        <mxCell id="138" value="Layout adapted from Tianyi Li et al., A Survey on Diffusion Language Models, Fig. 1 (arXiv:2508.10875v3). 内容・色分類・年・配置を変更。" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontFamily=Noto Sans CJK JP;fontSize=14;fontColor=#64748B;fontStyle=0;spacing=0;" vertex="1" parent="1" link="https://arxiv.org/pdf/2508.10875v3#page=2">
          <mxGeometry x="74" y="1471" width="1720" height="25" as="geometry" />
